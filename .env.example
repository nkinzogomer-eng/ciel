# Copier en .env.local (gitignoré) pour le développement local contre Base44.
# Ces valeurs sont fournies par `base44 link` / le Builder ; ne jamais committer de secret.

VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=

# Le noyau autonome n'utilise AUCUNE de ces variables.
# Sa configuration passe par la CLI : CIEL_TOKEN, CIEL_HOST, --port, --data <dir>.
